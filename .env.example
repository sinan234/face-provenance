# ==================================================================
#  Environment configuration — copy this file to `.env` and fill in.
#
#  SECURITY RULES
#  - NEVER commit `.env`.
#  - NEVER hardcode credentials in source code.
#  - The private key below is Anvil's public DEV account #0 key.
#    It exists only so the local dev chain works out of the box.
#    LOCAL DEV ONLY - never use this key anywhere else.
# ==================================================================

# ------------------------- Blockchain -------------------------
# RPC endpoint of the chain. Default: local Anvil on port 8545.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Chain id (Anvil: 31337, Ganache/Hardhat: 1337).
BLOCKCHAIN_CHAIN_ID=31337
# Private key of the account that submits provenance records.
# Anvil dev account #0 (LOCAL DEV ONLY):
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Set after running scripts/deploy_contract.py (or in .env yourself):
PROVENANCE_CONTRACT_ADDRESS=

# -------------------- Reverse-image search --------------------
# Provider name: `serper` (https://serper.dev — permitted Google Lens API)
SEARCH_PROVIDER=serper
# API key for the search provider (get one at https://serper.dev)
SEARCH_API_KEY=
SEARCH_REQUEST_TIMEOUT_SECONDS=30
SEARCH_MAX_CANDIDATES=20

# ------------- Image hosting for real reverse-image search -------------
# Serper's Lens API requires the image to be reachable at a public http(s)
# URL; it rejects local bytes. OPTIONALLY set this to a public URL of the
# input image to use it directly. When unset, the pipeline uploads the local
# image to a transient anonymous host (uguu.se) purely to obtain a public URL
# for the search.
SEARCH_IMAGE_URL=

# ------------------------- Web fetching ------------------------
REQUEST_TIMEOUT_SECONDS=20
# Browser-like UA improves fetchability of dynamic pages; robots.txt is still respected.
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
ROBOTS_TXT_RESPECT=true
MAX_PAGE_BYTES=2097152
MAX_IMAGE_BYTES=5242880

# --------------------------- Logging ---------------------------
LOG_LEVEL=INFO
